{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^24.15.0 || ^26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "i18n:check": "node scripts/check-i18n.mjs",
    "lint": "eslint --ext .js,.mjs,.ts,.vue src tests scripts",
    "format": "prettier --write .",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "prepare": "cd .. && husky frontend/.husky"
  },
  "dependencies": {
    "@primeuix/themes": "^2.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tato30/vue-pdf": "^2.2.1",
    "axios": "^1.20.0",
    "dompurify": "^3.4.17",
    "katex": "^0.19.0",
    "marked": "^18.1.1",
    "pdf-lib": "^1.17.1",
    "primeflex": "^4.0.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.44",
    "vue-eslint-parser": "^10.4.1",
    "vue-i18n": "^11.4.14",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@playwright/test": "^1.64.1",
    "@primevue/auto-import-resolver": "^4.5.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.4",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,ts,tsx,vue}": "pnpm exec eslint",
    "*": "pnpm exec prettier --check --ignore-unknown"
  }
}
