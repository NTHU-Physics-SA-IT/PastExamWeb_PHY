set -eu

cd "$(git rev-parse --show-toplevel)"

# Never hide partial changes or include protected user WIP in a commit.
node --input-type=module <<'NODE'
import { execFileSync } from 'node:child_process'

const changedPaths = (...args) =>
  execFileSync('git', ['diff', '--name-only', '--no-renames', '-z', ...args])
    .toString()
    .split('\0')
    .filter(Boolean)

const staged = new Set(changedPaths('--cached'))
if (staged.has('responsive-ui-governance.md')) {
  console.error('PROTECTED_USER_WIP_STAGED: responsive-ui-governance.md')
  process.exit(1)
}

const partial = changedPaths().filter((path) => staged.has(path))
if (partial.length) {
  console.error('PARTIALLY_STAGED_FILE_REQUIRES_REVIEW')
  for (const path of partial) console.error(JSON.stringify(path))
  process.exit(1)
}
NODE

cd frontend
pnpm exec lint-staged --no-stash --no-hide-partially-staged --no-revert
