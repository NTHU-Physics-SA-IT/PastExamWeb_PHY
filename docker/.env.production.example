# Compose interpolation contract only. Copy real values to the external,
# mode-0600 /etc/pastexam/compose.prod.env file; never commit that file.
# Backend runtime and migrator credentials remain in their separate external
# env files referenced below.
PRODUCTION_DEPLOY_ENABLED=false
PRODUCTION_BACKEND_ENV_FILE=/opt/pastexam-config/backend.env
PRODUCTION_MIGRATOR_ENV_FILE=/opt/pastexam-config/migrator.env
PRODUCTION_EDGE_COMPOSE_FILE=/etc/pastexam/docker-compose.edge.yml
PRODUCTION_TLS_CERT_FILE=/opt/pastexam-config/tls/origin.pem
PRODUCTION_TLS_KEY_FILE=/opt/pastexam-config/tls/origin-key.pem
# Choose an unused stable IPv4 address inside the existing pastexam-network
# subnet. The same value is assigned to nginx and trusted by Uvicorn.
PRODUCTION_NGINX_PROXY_IP=172.30.0.10

POSTGRES_USER=replace-with-cluster-bootstrap-role
POSTGRES_PASSWORD=replace-outside-git
POSTGRES_DB=archive_db

MINIO_ROOT_USER=replace-outside-git
MINIO_ROOT_PASSWORD=replace-outside-git

BACKEND_IMAGE=ghcr.io/example/pastexam:backend-immutable-digest
FRONTEND_IMAGE=ghcr.io/example/pastexam:frontend-immutable-digest
