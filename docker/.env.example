COMPOSE_PROJECT_NAME=pastexam-dev
DEV_HTTP_PORT=8080
DEV_HMR_PORT=24678
TARGET_NETWORK_NAME=pastexam-dev-network

POSTGRES_VOLUME_NAME=pastexam-postgres-data
REDIS_VOLUME_NAME=pastexam-redis-data
MINIO_VOLUME_NAME=pastexam-minio-data

POSTGRES_USER=pgadmin
POSTGRES_PASSWORD=pgadmin
POSTGRES_DB=archive_db
POSTGRES_PORT=5432
MIGRATOR_DB_USER=pastexam_migrator_local
MIGRATOR_DB_PASSWORD=local-migrator-only
APP_DB_USER=pastexam_runtime_local
APP_DB_PASSWORD=local-runtime-only
TEST_DB_USER=pastexam_test_local
TEST_DB_PASSWORD=local-test-only
TEST_DATABASE_NAME=pastexam_test_local

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=archive-bucket
MINIO_ACCESS_KEY=pastexam-app
MINIO_SECRET_KEY=local-application-only

SECRET_KEY=local-development-only-secret
DEFAULT_ADMIN_NAME=admin
DEFAULT_ADMIN_PASSWORD=local-admin-only
DEFAULT_ADMIN_EMAIL=admin@localhost.invalid

BACKEND_IMAGE=pastexam-backend-dev:latest
FRONTEND_IMAGE=pastexam-frontend-dev:latest
