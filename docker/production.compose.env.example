PRODUCTION_DEPLOY_ENABLED=false
PRODUCTION_BACKEND_ENV_FILE=/opt/pastexam-config/backend.env
PRODUCTION_MIGRATOR_ENV_FILE=/opt/pastexam-config/migrator.env

POSTGRES_USER=replace-with-cluster-bootstrap-role
POSTGRES_PASSWORD=replace-outside-git
POSTGRES_DB=archive_db

MINIO_ROOT_USER=replace-outside-git
MINIO_ROOT_PASSWORD=replace-outside-git

BACKEND_IMAGE=ghcr.io/example/pastexam:backend-immutable-digest
FRONTEND_IMAGE=ghcr.io/example/pastexam:frontend-immutable-digest
