# Copy to /opt/pastexam-config/backend.env on the production host with mode
# 0600. Never keep the real file in a release checkout.
DB_HOST=db
DB_PORT=5432
DB_USER=replace-with-runtime-role
DB_PASSWORD=replace-outside-git
DB_NAME=archive_db

SECRET_KEY=replace-outside-git
FRONTEND_URL=https://example.invalid
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=replace-with-scoped-child-access-key
MINIO_SECRET_KEY=replace-outside-git
MINIO_BUCKET_NAME=archive-bucket
EXTERNAL_ENDPOINT=https://example.invalid/minio
REDIS_URL=redis://redis:6379
LOGIN_RATE_LIMIT_PRINCIPAL_ATTEMPTS=8
LOGIN_RATE_LIMIT_IP_ATTEMPTS=50
LOGIN_RATE_LIMIT_WINDOW_SECONDS=600
LOGIN_RATE_LIMIT_COOLDOWN_SECONDS=600
DEFAULT_ADMIN_NAME=replace-outside-git
DEFAULT_ADMIN_EMAIL=admin@example.invalid
