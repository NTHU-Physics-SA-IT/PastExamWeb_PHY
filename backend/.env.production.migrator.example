# Copy to /opt/pastexam-config/migrator.env on the production host with mode
# 0600. The non-database values satisfy application configuration parsing but
# are not used by migrate.py.
DB_HOST=db
DB_PORT=5432
DB_USER=replace-with-migrator-role
DB_PASSWORD=replace-outside-git
DB_NAME=archive_db

SECRET_KEY=migrator-command-unused
FRONTEND_URL=https://example.invalid
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=migrator-command-unused
MINIO_SECRET_KEY=migrator-command-unused
MINIO_BUCKET_NAME=migrator-command-unused
EXTERNAL_ENDPOINT=https://example.invalid/minio
REDIS_URL=redis://redis:6379
DEFAULT_ADMIN_NAME=migrator-command-unused
DEFAULT_ADMIN_EMAIL=migrator@example.invalid
