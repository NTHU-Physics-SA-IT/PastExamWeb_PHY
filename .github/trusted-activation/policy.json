{
  "schema_version": 1,
  "policy_version": "trusted-activation-v1",
  "repository": {
    "id": 1271339534,
    "full_name": "NTHU-Physics-SA-IT/PastExamWeb_PHY",
    "default_branch": "main"
  },
  "integration_branch_pattern": "integration/*",
  "claim_path": ".github/trusted-activation/claim.json",
  "ledger_paths": {
    "grants": ".github/trusted-activation/grants",
    "revocations": ".github/trusted-activation/revocations",
    "tombstones": ".github/trusted-activation/tombstones"
  },
  "trusted_check": {
    "name": "Trusted Governance Gate",
    "candidate_actions_app_id": 15368
  },
  "ruleset": {
    "name": "trusted-integration-lifecycle",
    "target": "branch",
    "include": [
      "refs/heads/integration/*"
    ],
    "required_checks": [
      "check-branch",
      "CI Gate",
      "Trusted Governance Gate"
    ],
    "require_pull_request": true,
    "required_approvals": 1,
    "require_code_owner_review": true,
    "dismiss_stale_reviews": true,
    "require_last_push_approval": true,
    "require_conversation_resolution": true,
    "block_force_push": true,
    "restrict_creation": true,
    "restrict_deletion": true
  }
}
