{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NTHU-Physics-SA-IT/PastExamWeb_PHY/.github/trusted-activation/schemas/grant.schema.json",
  "title": "Trusted Activation Grant",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "repository_id", "repository", "branch", "activation_id", "grant_parent_sha", "policy_version", "policy_digest", "ruleset_id", "ruleset_digest", "verifier_app_id", "issuance_contract", "issued_at"],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "grant"},
    "repository_id": {"type": "integer", "minimum": 1},
    "repository": {"const": "NTHU-Physics-SA-IT/PastExamWeb_PHY"},
    "branch": {"type": "string", "pattern": "^integration/[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "activation_id": {"type": "string", "format": "uuid"},
    "grant_parent_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "policy_version": {"const": "trusted-activation-v1"},
    "policy_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ruleset_id": {"type": "integer", "minimum": 1},
    "ruleset_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "verifier_app_id": {"type": "integer", "minimum": 1},
    "issuance_contract": {"const": "protected-main-app-environment-v1"},
    "issued_at": {"type": "string", "format": "date-time"}
  }
}
